# oh-my-claudecode session state
.omc/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/

# ROS 2 / colcon (future workspaces, root-level only — keep docs/build/)
/build/
/install/
/log/

# MkDocs build output
/site/

# ROS 2 colcon build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
# Upstream source cloned for the Harmonic build, not vendored
ros2_ws/src/gz_ros2_control/

# Student bundle export (scripts/export_student_bundle.sh)
/dist/

# Marp PPTX output; the PDFs under docs/ are committed, these are not
/course/dist/

# Reference decks used only to inspect an existing theme.
# This repo is public and deploys to GitHub Pages - committing a
# lecture deck from another course would publish it.
/course/reference/

# Per-student lab submission config (name, uniqname, private repo URL)
/.labconfig

# Course roster: student names and repo URLs. This repository is PUBLIC and
# deploys to GitHub Pages - a committed roster would publish it.
/course/roster*.txt
# Marks. Student grade data - must never be committed.
/course/scores-*.tsv
# Instructor's merge, standup and demo records. Grade data as well.
/course/records-*.md

# OpenSCAD build output
*.stl

# WireViz intermediates — the SVG and the BOM are committed, these are not
harness/*.gv
harness/*.html
harness/*.png
docs/images/.system-overview.gv

# pytest
.pytest_cache/

# 컨테이너 빌드 산출물을 네이티브 CMake 캐시와 분리한다. 설치 결과에는 절대
# 경로가 들어 있어서 /work 마운트와 호스트 checkout 사이에서 공유하면 깨진다.
# tools/ros2/verify.sh가 /.dockerenv를 보고 이 base를 선택한다.
ros2_ws/build-docker/
ros2_ws/install-docker/
ros2_ws/log-docker/
ros2_ws/legacy-build-*/

# ROS 실행 로그
.ros/
