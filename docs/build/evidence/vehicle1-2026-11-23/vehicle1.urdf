    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0.20943951023931956 0" xyz="0.02 0 0.056499999999999995"/>
  </joint>
  <!-- REP-103 optical frame: z forward, x right, y down. -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <topic>camera/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <!-- ==== IMU ============================================================= -->
  <!-- Mounted low and central. Orientation relative to base_link is published
       as a static transform here rather than as a driver parameter, because a
       wrong IMU rotation corrupts yaw silently (docs/design/calibration.md 5). -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.006"/>
      </geometry>
      <material name="imu_body"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="3.6333333333333333e-07" ixy="0.0" ixz="0.0" iyy="3.6333333333333333e-07" iyz="0.0" izz="6.666666666666667e-07"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.18655 0 0.161"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <ros2_control name="MittSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Front steering: POSITION commanded, matching the Teensy's local
           position loop. The controller asks for an angle; firmware closes
           the loop against the load-side absolute sensor. -->
    <joint name="front_left_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <!-- Rear traction: VELOCITY commanded. -->
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <!-- Front road wheels: STATE ONLY, no command interface. These are
           passive - they free-wheel, nothing drives them.
           They are listed here purely so joint_state_broadcaster publishes
           them. Without that, robot_state_publisher cannot compute
           front_{left,right}_wheel_link, those two frames are ABSENT from TF
           entirely, and RViz's RobotModel display errors on them.

           Making them <fixed> would also silence RViz and is the wrong fix:
           Gazebo would then drag the front wheels instead of rolling them,
           quietly corrupting the steering and friction behaviour the twin
           exists to reproduce.

           HONESTY NOTE, and it matters for Track B. The real vehicle has NO
           front-wheel encoders. In sim these values are ground truth; on
           hardware mitt_hardware/MittSystem must still export the interfaces
           (ros2_control validates the URDF against the plugin and refuses to
           start on a mismatch), but what it reports will be a KINEMATIC
           ESTIMATE from vehicle speed, omega = v / wheel_radius, not a
           measurement. Nothing may consume these as feedback - they exist for
           visualisation and TF completeness only. Same rule as the shared
           rear encoder noted above. -->
    <joint name="front_left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/root/mrider-team/ros2_ws/install-docker/mitt_control/share/mitt_control/config/mitt_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
