<!--
  MITT (Michigan Intelligent Transportation Tech) - top-level description.

  Build with:
    xacro mitt.urdf.xacro sim:=true   > /tmp/mitt.urdf
    check_urdf /tmp/mitt.urdf

  All geometry derives from mitt_description/config/mitt_dimensions.yaml.
  Nothing in that file has been measured yet - see its header. A vehicle's
  measured values live in config/vehicles/vehicle<N>.yaml and are laid over
  it with vehicle:=N (urdf/mitt_dimensions.xacro).
-->
<robot name="mitt">
  <!-- urdf/mitt_dimensions.xacro -->
  <material name="mitt_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>
  <material name="mitt_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="mitt_accent">
    <color rgba="0.10 0.35 0.65 1.0"/>
  </material>
  <!-- Wheels/sensors were previously all one of two greys, which made the
       LiDAR, camera and mast indistinguishable and a wheel a black puck.
       Orientation legibility is worth real points in every TF and Nav2 lab. -->
  <material name="mitt_tyre">
    <color rgba="0.10 0.10 0.11 1.0"/>
  </material>
  <material name="mitt_rim">
    <color rgba="0.62 0.63 0.66 1.0"/>
  </material>
  <!-- ==== base_link ======================================================= -->
  <!-- Massless reference frame at the rear axle centre, on the ground. -->
  <link name="base_link"/>
  <link name="chassis_link">
    <!-- Body shell mesh. See meshes/README.md for provenance (Fuel "SUV" by
         Open Robotics, CC0) and for how it was prepared.

         NO GEOMETRIC LITERALS HERE EITHER. The mesh is normalised to a unit
         bounding box - span 1.0 per axis, centred on X/Y, resting on Z=0 - so
         <scale> below IS the vehicle's size in metres, taken from the same
         yaml as everything else. The z offset of -body_h/2 lifts the unit box
         onto the link origin, which is why the mesh occupies EXACTLY the same
         envelope as the collision box beneath it. Measure the real vehicle,
         update the yaml, and the shell follows.

         The mesh is a visual proxy for a Defender-style ride-on, NOT a scan of
         the donor vehicle. Nothing is dimensioned from it. -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.235"/>
      <geometry>
        <mesh filename="package://mitt_description/meshes/mitt_body.obj" scale="0.98 0.56 0.47"/>
      </geometry>
      <!-- NO <material> HERE, DELIBERATELY. A material on a mesh visual is
           converted to an SDF <material> whose diffuse colour OVERRIDES the
           mesh's own, which is what suppressed the body texture until
           2026-09-04. Leaving it off lets mitt_body.mtl paint the shell in
           both Gazebo and RViz. See meshes/README.md for the full correction. -->
    </visual>
    <!-- Collision stays a PRIMITIVE BOX, deliberately. Mesh collision would
         cost physics time for no benefit here, and would couple the collision
         envelope to whatever mesh happens to be installed - so swapping the
         shell would silently change the vehicle's physics. Keeping the box
         means the documented dimensions remain the single source of truth. -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.98 0.56 0.47"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.3563333333333333" ixy="0.0" ixz="0.0" iyy="0.7875333333333332" iyz="0.0" izz="0.8493333333333333"/>
    </inertial>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin rpy="0 0 0" xyz="0.2665 0 0.3023333333333333"/>
  </joint>
  <link name="equipment_plate_link">
    <visual>
      <geometry>
        <box size="0.392 0.392 0.02"/>
      </geometry>
      <material name="mitt_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.392 0.392 0.02"/>
      </geometry>
