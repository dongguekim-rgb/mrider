  <!-- REMOVED 2026-09-04: <gazebo reference="chassis_link">
         <material>Gazebo/White</material></gazebo> and its DarkGrey twin.
       Gazebo/* are Gazebo CLASSIC material-script names with no meaning in
       Harmonic, so they never did anything - and on the chassis the intent was
       actively wrong, since the body is now textured from its own MTL. Link
       colours come from the URDF <material> tags above. -->
  <material name="mast_grey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <!-- Distinct per sensor. These were all mast_grey, which made the LiDAR,
       camera and IMU indistinguishable from the pole they hang off - a
       genuine nuisance when a lab asks "where is base_link -> laser_link?" -->
  <material name="lidar_body">
    <color rgba="0.12 0.13 0.15 1.0"/>
  </material>
  <material name="lidar_cap">
    <color rgba="0.85 0.62 0.10 1.0"/>
  </material>
  <material name="camera_body">
    <color rgba="0.16 0.17 0.19 1.0"/>
  </material>
  <material name="camera_lens">
    <color rgba="0.20 0.45 0.70 1.0"/>
  </material>
  <material name="imu_body">
    <color rgba="0.20 0.55 0.30 1.0"/>
  </material>
  <link name="mast_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.09825"/>
      <geometry>
        <cylinder length="0.1965" radius="0.015"/>
      </geometry>
      <material name="mast_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.09825"/>
      <geometry>
        <cylinder length="0.1965" radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.09825"/>
      <mass value="0.4"/>
      <inertia ixx="0.001309575" ixy="0.0" ixz="0.0" iyy="0.001309575" iyz="0.0" izz="4.5e-05"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin rpy="0 0 0" xyz="0.23985 0 0.4535"/>
  </joint>
  <!-- ==== 2D LiDAR ======================================================== -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder length="0.041" radius="0.038"/>
      </geometry>
      <material name="lidar_body"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0215"/>
      <geometry>
        <cylinder length="0.006" radius="0.0345"/>
      </geometry>
      <material name="lidar_cap"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.041" radius="0.038"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.19"/>
      <inertia ixx="9.520583333333332e-05" ixy="0.0" ixz="0.0" iyy="9.520583333333332e-05" iyz="0.0" izz="0.00013718"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="laser_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1365"/>
  </joint>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>laser_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <!-- A1M8 is a triangulation unit; 1 cm sigma is optimistic at
               range and should be re-tuned against real scans. -->
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- ==== Front camera ==================================================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.09 0.025"/>
      </geometry>
      <material name="camera_body"/>
    </visual>
    <visual>
      <origin rpy="0 1.5707963267948966 0" xyz="0.016 0 0"/>
